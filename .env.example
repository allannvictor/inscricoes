# Banco Postgres (Neon em produção; local: postgres://usuario:senha@localhost:5432/inscricoes)
DATABASE_URL=postgres://inscricoes:inscricoes@localhost:5432/inscricoes

# Endereço público do site (sem barra no fim). Usado nos e-mails e no webhook do Mercado Pago.
APP_URL=http://localhost:3000

# E-mail (Resend). Sem RESEND_API_KEY os e-mails só aparecem no terminal.
RESEND_API_KEY=
EMAIL_FROM="Inscrições <onboarding@resend.dev>"

# Mercado Pago. Sem MP_ACCESS_TOKEN o site roda em MODO SIMULADO (botão "Simular Pix recebido").
MP_ACCESS_TOKEN=
# Chave secreta do webhook (Suas integrações > Webhooks). Opcional, mas recomendada.
MP_WEBHOOK_SECRET=

# Apenas desenvolvimento/testes automáticos: aceita este código fixo no login. Ignorado em produção.
LOGIN_CODIGO_TESTE=

# Segredo para sessões e códigos de login (obrigatório em produção; texto longo e aleatório).
SESSION_SECRET=

# Só para prévias de teste sem Mercado Pago em produção. NUNCA deixe ligado com inscrições reais.
PERMITIR_SIMULADO=

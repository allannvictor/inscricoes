# Banco Postgres (Neon em produção; local: postgres://usuario:senha@localhost:5432/inscricoes)
DATABASE_URL=postgres://inscricoes:inscricoes@localhost:5432/inscricoes

# Endereço público do site (sem barra no fim). Usado nos e-mails e no webhook do Mercado Pago.
APP_URL=http://localhost:3000

# E-mail (Resend). Sem RESEND_API_KEY os e-mails só aparecem no terminal.
RESEND_API_KEY=
EMAIL_FROM="Inscrições <onboarding@resend.dev>"

# Mercado Pago. Sem MP_ACCESS_TOKEN o site roda em MODO SIMULADO (botão "Simular Pix recebido").
MP_ACCESS_TOKEN=
# Chave secreta do webhook (Suas integrações > Webhooks). Opcional, mas recomendada.
MP_WEBHOOK_SECRET=

# Código fixo de login (6 dígitos) para desenvolvimento e HOMOLOGAÇÃO (Preview). Com ele, nenhum e-mail de código é enviado.
# Ignorado em produção.
LOGIN_CODIGO_TESTE=

# Segredo para sessões e códigos de login (obrigatório em produção; texto longo e aleatório).
SESSION_SECRET=

# Só para prévias de teste sem Mercado Pago em produção. NUNCA deixe ligado com inscrições reais.
PERMITIR_SIMULADO=

# Modo "em breve": com PRE_LANCAMENTO=1 o público vê só "Inscrições em breve".
# Você entra abrindo qualquer página com ?acesso=<CHAVE_PRE_LANCAMENTO> (fica liberado por 90 dias nesse navegador).
PRE_LANCAMENTO=
CHAVE_PRE_LANCAMENTO=

# Usuários master: acessam o painel de QUALQUER clube (e-mails separados por vírgula, login por código).
ADMIN_EMAILS=

# Vercel Blob (imagem do evento, foto do clube, regulamento). Criado em Storage > Blob na Vercel.
# Sem ele, em desenvolvimento os arquivos vão para public/uploads.
BLOB_READ_WRITE_TOKEN=

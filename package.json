{
  "name": "inscricoes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run db:migrate && tsx src/db/seed.ts --so-se-RODAR_SEED && next build",
    "start": "next start",
